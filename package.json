{
  "name": "scienfactory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:lab": "bun tests/lab.integration.ts",
    "test:live": "bun tests/provider.live.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "lab:build": "docker build -t scienfactory-lab:local -f containers/lab.Dockerfile .",
    "lab:research": "docker build -t scienfactory-lab:research -f containers/research.Dockerfile .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:research": "bun tests/research.live.ts",
    "test:browser-live": "bun tests/browser.live.ts",
    "test:canvas-live": "bun tests/canvas.live.ts",
    "test:engineering": "bun tests/engineering.live.ts",
    "test:engineering-review": "bun tests/review-engineering.ts",
    "lab:mathlib": "docker build -t scienfactory-lab:mathlib -f containers/mathlib.Dockerfile .",
    "test:files": "bun tests/files.integration.ts",
    "test:latex": "bun tests/article.integration.ts",
    "test:publishing": "bun tests/publishing.local.ts",
    "test:publishing-browser": "bun tests/publishing.browser.ts",
    "test:publishing-review": "bun tests/review-publishing.ts",
    "test:article-live": "bun tests/article.live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@elysiajs/static": "1.4.10",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "elysia": "1.4.30",
    "ipaddr.js": "2.5.0",
    "katex": "0.18.7",
    "lucide-react": "1.43.0",
    "openai": "7.13.0",
    "pdfjs-dist": "5.4.624",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "three": "0.186.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
